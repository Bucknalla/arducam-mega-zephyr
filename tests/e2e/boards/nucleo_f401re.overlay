/*
 * Board overlay for STM32 NUCLEO-F401RE.
 *
 * Arducam MEGA wiring:
 *   MOSI  -> PA7  (SPI1_MOSI)
 *   MISO  -> PA6  (SPI1_MISO)
 *   SCK   -> PA5  (SPI1_SCK)
 *   CS    -> PA4
 *   VCC   -> 3.3 V
 *   GND   -> GND
 */

&spi1 {
	status = "okay";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

	arducam_mega_cam: camera@0 {
		compatible = "arducam,mega";
		reg = <0>;
		spi-max-frequency = <8000000>;
		label = "ARDUCAM_MEGA";
	};
};
